# 로컬 개발 예시다. 실제 값은 .env 에 넣고 커밋하지 않는다.
# GCP 운영 시작값은 AI_MAX_INFLIGHT=1이다. 이 개발용 파일 전체를 운영에 전달하지 않는다.
AI_SERVICE_TOKEN=change-me                  # BE 서비스 secret (Bearer). BE 설정과 같은 값
AI_CONCEPT_IDF=data/private/concepts/idf.json
AI_MAX_INFLIGHT=4

# LLM 제공자: anthropic | openai | google
#   모델 기본값: anthropic → claude-opus-5-5, google → gemini-3.5-flash, openai → 없음 (AI_LLM_MODEL 필수)
AI_LLM_PROVIDER=google
AI_LLM_MODEL=
AI_LLM_TIMEOUT_SECONDS=90
# 역할별로 다른 제공자·모델을 쓸 때 (예: 관계 판정만 Claude)
# AI_RELATION_LLM_PROVIDER=anthropic
# AI_RELATION_LLM_MODEL=claude-opus-5-5

# 관계 유형 LLM 판정 (extract-hybrid-1) 켜기
AI_RELATION_LLM=0
AI_RELATION_CACHE=data/private/cache/relations

# 제공자 인증 (쓰는 것만 채운다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 켤 임베딩 profile (쉼표 구분). embeddings-e5-small-1 은 `uv sync --extra embeddings` 와 모델 내려받기가 필요하다
AI_EMBEDDING_PROFILES=embeddings-hash-dev-1

GEMINI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
